# LeDeuxions AI Backend — 환경 변수
# 이 파일을 .env로 복사하고 값을 채우세요.

# Cloudflare Worker가 보내는 X-API-Key와 일치해야 함.
# 긴 랜덤 문자열로 만드세요: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-long-random-string

# CORS 허용 도메인 (콤마 구분)
# Worker만 호출하는 구조라면 비워둬도 됨 (브라우저 직접 호출은 Worker 통해 가는 게 보안상 안전)
ALLOWED_ORIGINS=https://ledeuxions.com,https://pdf.ledeuxions.com

# Whisper 모델 — "large-v3" 권장, 메모리 부족시 "medium" 또는 "small"
WHISPER_MODEL=large-v3

# faster-whisper 연산 정밀도. Mac에서는 int8 권장 (속도 + 메모리)
WHISPER_COMPUTE=int8

# rembg 모델 — u2net(범용), isnet-general-use(고화질), u2netp(경량)
REMBG_MODEL=u2net

# 포트
PORT=5000
