{
  "name": "HEIC to JPG Converter",
  "short_name": "HEIC Convert",
  "description": "Convert iPhone HEIC/HEIF photos to JPG or PNG on your phone. Works offline. No upload.",
  "id": "/web-projects/iphone-heic/",
  "start_url": "/web-projects/iphone-heic/",
  "scope": "/web-projects/iphone-heic/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0078d7",
  "lang": "en",
  "icons": [
    { "src": "/web-projects/iphone-heic/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/web-projects/iphone-heic/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/web-projects/iphone-heic/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/web-projects/iphone-heic/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["image/heic", "image/heif", ".heic", ".heif", ".HEIC", ".HEIF"]
        }
      ]
    }
  }
}
