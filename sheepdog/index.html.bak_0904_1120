  시트.양 = 양im; 시트.양뒤 = 뒤집기(양im); 시트.개 = 개im; 시트.개뒤 = 뒤집기(개im);
  이어.disabled = false;
  if (기록.탄 > 1){
    이어.textContent = `이어하기 ${기록.탄}탄`; 이어.onclick = () => 시작(기록.탄);
    처음.classList.remove('숨김'); 처음.onclick = () => { 기록.탄 = 1; 저장.쓰기(기록); 시작(1); };
  } else { 이어.textContent = '시작'; 이어.onclick = () => 시작(1); }
  if (별합() > 0) document.getElementById('모은별').textContent = `모은 별 ${별합()}/${탄들.length*3}`;
});
if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('sw.js').catch(()=>{}));
</script>
