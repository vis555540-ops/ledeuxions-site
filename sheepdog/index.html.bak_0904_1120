<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden;background:#2c3a22;
    font-family:"Noto Sans KR",-apple-system,BlinkMacSystemFont,sans-serif;
    user-select:none;-webkit-user-select:none;touch-action:none}
  #틀{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#2c3a22}
  #폰{position:relative;background:#6f9448;overflow:hidden;box-shadow:0 0 0 2px rgba(0,0,0,.35),0 18px 50px rgba(0,0,0,.45)}
  #판{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges}
  .막{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:rgba(28,38,20,.84);color:#f6f1e0;text-align:center;padding:24px;gap:12px;z-index:5}
  .숨김{display:none!important}
  .막 h1{font-size:clamp(26px,7vw,46px);font-weight:800;letter-spacing:.06em}
  .막 p{font-size:clamp(14px,3.6vw,18px);line-height:1.7;opacity:.92;max-width:22em}
  .막 button{margin-top:6px;padding:14px 34px;font-size:clamp(16px,4vw,20px);font-weight:700;
    border:0;border-radius:999px;background:#f6d365;color:#3b3218;cursor:pointer;
    box-shadow:0 4px 0 #c9a83e;min-width:11em}
  .막 button.버금{background:#d8d2bf;box-shadow:0 4px 0 #a9a390;font-size:clamp(14px,3.4vw,17px);padding:10px 26px}
  .막 button:disabled{opacity:.5;cursor:default}
  .막 button:active:not(:disabled){transform:translateY(3px);box-shadow:0 1px 0 #c9a83e}
  #머리{position:absolute;top:0;left:0;right:0;padding:10px 12px;display:flex;justify-content:space-between;
    align-items:center;color:#f6f1e0;font-weight:700;font-size:clamp(13px,3.4vw,17px);
    text-shadow:0 2px 4px rgba(0,0,0,.45);z-index:3;pointer-events:none;gap:8px}
  #시간칸{flex:1;height:10px;background:rgba(0,0,0,.3);border-radius:99px;overflow:hidden}
  #시간{height:100%;width:100%;background:#f6d365;transition:width .2s linear}
  #시간.급함{background:#e8674f}
  .별{font-size:clamp(30px,9vw,52px);letter-spacing:.18em;color:#f6d365}
  #소리단추{pointer-events:auto;background:rgba(0,0,0,.28);border:0;color:#f6f1e0;border-radius:99px;
    width:2.1em;height:2.1em;font-size:inherit;cursor:pointer}
  #짖기단추{position:absolute;right:14px;bottom:16px;z-index:4;width:clamp(58px,17vw,78px);height:clamp(58px,17vw,78px);
    border-radius:50%;border:0;background:#f6d365;color:#3b3218;font-weight:800;font-size:clamp(14px,3.8vw,18px);
    box-shadow:0 5px 0 #c9a83e,0 8px 16px rgba(0,0,0,.35);cursor:pointer;display:none}
  #짖기단추:active{transform:translateY(4px);box-shadow:0 1px 0 #c9a83e}
  #짖기단추.식힘{opacity:.45}
  #짖기단추.보임{display:block}
  .작게{font-size:clamp(12px,3vw,14px);opacity:.65}
</style>
</head>
<body>
<div id="틀"><div id="폰"><canvas id="판"></canvas>
<div id="머리"><span id="단계">1탄</span><span id="시간칸"><i id="시간"></i></span><span id="셈">양 0/1</span>
  <button id="소리단추" title="소리">🔊</button></div>
<button id="짖기단추">짖기</button>
</div></div>

<div class="막" id="첫막">
  <h1>양몰이</h1>
  <p>개를 끌어서 양을 울타리에 넣어라.<br>양은 개를 무서워한다. 너무 붙으면 흩어진다.<br>문은 아래쪽 하나뿐이다.</p>
  <p class="작게">화면을 누르면 개가 그리로 간다 · 「짖기」로 넓게 겁준다</p>
  <button id="이어단추" disabled>읽는 중…</button>
  <button id="처음단추" class="버금 숨김">처음부터</button>
  <p class="작게" id="모은별"></p>
</div>

<div class="막 숨김" id="끝막">
  <h1 id="끝말">잘했다</h1>
  <div class="별" id="별"></div>
  <p id="끝풀이"></p>
  <button id="다음단추">다음</button>
  <button id="다시단추" class="버금">다시</button>
</div>

<script>
// ═══════════════════════════════════════════════════════════
//  양몰이 — 2026-09-04 손봄
//  · 속판 140×303 → 180×390 (32도트 동작 그림에 맞춤)
//  · 울타리는 문으로만 들어간다 (개는 못 들어간다)
//  · 개·양 동작 그림 (양_동작.png / 개_동작.png, 32×32 칸)
//  · 짖기 · 소리(합성, 파일 없음) · 탄 10개 · 진행 저장 · 오프라인(sw.js)
// ═══════════════════════════════════════════════════════════

// ── 판 크기 --------------------------------------------------
const 폰비율 = 9/19.5;
const 안폭 = 180, 안높 = Math.round(안폭/폰비율);        // 180 × 390
const W = 안폭, H = 안높;
const 칸 = 32;                                          // 동작 그림 한 칸
const 양반 = 12, 개반 = 13;                              // 몸통 반지름 (셈용)

const 판 = document.getElementById('판'), g = 판.getContext('2d');
const 속판 = document.createElement('canvas'); 속판.width = W; 속판.height = H;
const ag = 속판.getContext('2d'); ag.imageSmoothingEnabled = false;
const 바탕 = document.createElement('canvas'); 바탕.width = W; 바탕.height = H;   // 한 번만 그린다

function 판크기(){
  const r = window.devicePixelRatio || 1;
  let w = window.innerWidth, h = window.innerHeight;
  if (w/h > 폰비율) w = Math.round(h*폰비율); else h = Math.round(w/폰비율);
  const 폰 = document.getElementById('폰');
  폰.style.width = w+'px'; 폰.style.height = h+'px';
  판.width = Math.round(w*r); 판.height = Math.round(h*r);
  g.setTransform(r,0,0,r,0,0); g.imageSmoothingEnabled = false;
}
addEventListener('resize', 판크기);
document.addEventListener('visibilitychange', () => { if (!document.hidden) S.마지막 = performance.now(); });

// ── 동작 그림 --------------------------------------------------
//  줄 = 시트의 몇 번째 줄, 수 = 칸 수, 틱 = 한 칸 머무는 초
const 양동작 = {가만:{줄:0,수:2,틱:.5}, 걷기:{줄:1,수:4,틱:.13}, 먹기:{줄:2,수:5,틱:.22},
               앉기:{줄:3,수:2,틱:.6}, 잠:{줄:4,수:2,틱:.7}, 놀람:{줄:5,수:2,틱:.15}};
const 개동작 = {가만:{줄:0,수:2,틱:.5}, 걷기:{줄:1,수:4,틱:.13}, 달리기:{줄:2,수:4,틱:.09},
               하품:{줄:3,수:4,틱:.2}, 앉기:{줄:4,수:2,틱:.6}, 짖기:{줄:5,수:2,틱:.12}};
const 시트 = {양:null, 양뒤:null, 개:null, 개뒤:null};

function 뒤집기(im){
  const d = document.createElement('canvas'); d.width = im.width; d.height = im.height;
  const x = d.getContext('2d'); x.translate(im.width,0); x.scale(-1,1); x.drawImage(im,0,0); return d;
}
function 그림읽기(src){
  return new Promise(res => { const i = new Image(); i.onload = () => res(i); i.onerror = () => res(null); i.src = src; });
}
// 동작 바꾸기 — 같은 동작이면 그대로, 다르면 첫 칸부터
function 동작(e, 이름){ if (e.동작 !== 이름){ e.동작 = 이름; e.칸 = 0; e.칸시간 = 0; } }
function 동작틱(e, 표, dt){
  const d = 표[e.동작]; e.칸시간 += dt;
  while (e.칸시간 >= d.틱){ e.칸시간 -= d.틱; e.칸 = (e.칸+1) % d.수; }
}
// 그림은 왼쪽을 본다. 본다=+1(오른쪽)이면 뒤집은 시트를 쓴다
function 동작그리기(e, 표, 앞, 뒤){
  const d = 표[e.동작], im = e.본다 > 0 ? 뒤 : 앞;
  const sx = e.본다 > 0 ? im.width - (e.칸+1)*칸 : e.칸*칸;
  ag.drawImage(im, sx, d.줄*칸, 칸, 칸, Math.round(e.x-칸/2), Math.round(e.y-칸/2+2), 칸, 칸);
}

// ── 소리 ---------------------------------------------------------
//  소리/*.mp3 는 소리_만들기.py 로 만든 원곡. 못 읽으면 합성음으로 대신한다.
const 소리 = {
  켬: true, ctx: null, 마지막매: 0, 버퍼: {}, 배경: null, 배경이름: null, 배경음량: null, 효과음량: null,
  이름들: ['배경_목장','배경_첫화면','이김','짐','들임','짖기','양','누름'],
  준비(){
    if (!this.ctx){
      try{ this.ctx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ this.ctx = null; return; }
      this.배경음량 = this.ctx.createGain(); this.배경음량.gain.value = .38; this.배경음량.connect(this.ctx.destination);
      this.효과음량 = this.ctx.createGain(); this.효과음량.gain.value = .9;  this.효과음량.connect(this.ctx.destination);
      for (const n of this.이름들)
        fetch('소리/'+n+'.mp3').then(r => r.ok ? r.arrayBuffer() : Promise.reject())
          .then(ab => this.ctx.decodeAudioData(ab)).then(bf => { this.버퍼[n] = bf; if (this.배경이름 === n && !this.배경) this.배경틀기(n); })
          .catch(()=>{});
    }
    if (this.ctx.state === 'suspended') this.ctx.resume();
  },
  틀기(n, 세기=1){
    if (!this.켬 || !this.ctx) return false;
    const bf = this.버퍼[n]; if (!bf) return false;
    const src = this.ctx.createBufferSource(), v = this.ctx.createGain();
    src.buffer = bf; v.gain.value = 세기; src.connect(v).connect(this.효과음량); src.start(); return true;
  },
  배경틀기(n){
    this.배경이름 = n;
    if (this.배경){ try{ this.배경.stop(); }catch(e){} this.배경 = null; }
    if (!this.켬 || !this.ctx || !this.버퍼[n]) return;
    const src = this.ctx.createBufferSource(); src.buffer = this.버퍼[n]; src.loop = true;
    src.connect(this.배경음량); src.start(); this.배경 = src;
  },
  배경끄기(){ if (this.배경){ try{ this.배경.stop(); }catch(e){} this.배경 = null; } this.배경이름 = null; },
  // 합성음 (파일을 못 읽었을 때만)
  음(주파, 길이, 꼴='square', 세기=.15, 미끄럼=0, 늦게=0){
    if (!this.켬 || !this.ctx) return;
    const c = this.ctx, t = c.currentTime + 늦게;
    const o = c.createOscillator(), v = c.createGain();
    o.type = 꼴; o.frequency.setValueAtTime(주파, t);
    if (미끄럼) o.frequency.linearRampToValueAtTime(Math.max(40, 주파+미끄럼), t+길이);
    v.gain.setValueAtTime(0.0001, t); v.gain.linearRampToValueAtTime(세기, t+0.01);
    v.gain.exponentialRampToValueAtTime(0.0001, t+길이);
    o.connect(v).connect(this.효과음량); o.start(t); o.stop(t+길이+0.02);
  },
  짖기(){ if (!this.틀기('짖기')){ this.음(330,.09,'square',.18,-140); this.음(270,.11,'square',.16,-120,.1); } },
  매(){
    const now = performance.now(); if (now - this.마지막매 < 450) return; this.마지막매 = now;
    if (!this.틀기('양', .7)) this.음(440,.25,'sawtooth',.06,40);
  },
  들임(){ if (!this.틀기('들임')){ this.음(660,.08,'triangle',.18); this.음(880,.14,'triangle',.18,0,.08); } },
  이김(){ if (!this.틀기('이김')) [523,659,784,1047].forEach((f,i)=>this.음(f,.18,'triangle',.18,0,i*.11)); },
  짐(){ if (!this.틀기('짐')){ this.음(220,.35,'sawtooth',.12,-90); this.음(160,.4,'sawtooth',.1,-60,.2); } },
  누름(){ this.틀기('누름', .5); },
};
// 폰은 손을 대기 전엔 소리를 못 낸다 — 첫 손길에 깨우고 첫화면 음악을 튼다
addEventListener('pointerdown', () => { 소리.준비(); if (!S.도는중 && !소리.배경) 소리.배경틀기('배경_첫화면'); }, {passive:true});

// ── 저장 --------------------------------------------------------
const 저장 = {
  읽기(){ try{ return JSON.parse(localStorage.getItem('양몰이')) || {}; }catch(e){ return {}; } },
  쓰기(o){ try{ localStorage.setItem('양몰이', JSON.stringify(o)); }catch(e){} },
};
let 기록 = Object.assign({탄:1, 별:{}, 소리:true}, 저장.읽기());
소리.켬 = 기록.소리 !== false;

// ── 탄 --------------------------------------------------------
const 탄들 = [
  {양:1, 시간:30}, {양:2, 시간:34}, {양:3, 시간:38}, {양:4, 시간:44}, {양:5, 시간:48},
  {양:6, 시간:52}, {양:7, 시간:56}, {양:8, 시간:60}, {양:10, 시간:70}, {양:12, 시간:80},
];
function 단계값(n){ const t = 탄들[Math.min(n,탄들.length)-1]; return {양:t.양, 시간:t.시간, 겁: 1 + n*0.04}; }

// ── 판 상태 ------------------------------------------------------
const S = {단계:1, 양들:[], 개:{x:0,y:0,vx:0,vy:0,본다:-1,동작:'가만',칸:0,칸시간:0,쉼:0,짖는중:0},
           목표:null, 울:{x:0,y:0,w:0,h:0}, 문:{왼:0,오:0},
           남은:0, 총시간:0, 도는중:false, 든양:0, 마지막:0, 짖음:0, 짖기쿨:0, 겁:1};

function 울타리자리(){
  const w = Math.round(W*0.66), h = Math.round(H*0.17);
  S.울 = {x: Math.round((W-w)/2), y: Math.round(H*0.07), w, h};
  const 문폭 = 34;
  S.문 = {왼: Math.round(S.울.x+w/2-문폭/2), 오: Math.round(S.울.x+w/2+문폭/2)};
}

// 울타리 = 네모의 테두리. 안으로 들어가는 길은 아래 문뿐.
//  ① 밖에 있던 것이 안으로 들어오려면: 아래에서, 문 폭 안에서만
//  ② 안에 든 양은 못 나온다  ③ 개는 아예 못 들어온다
function 울타리막기(e, 전x, 전y, 반, 문통과){
  const u = S.울, m = 문통과 ? 6 : Math.round(반*0.7);        // 개는 판자에서 조금 더 떨어진다
  const 안 = (x,y) => x > u.x-m && x < u.x+u.w+m && y > u.y-m && y < u.y+u.h+m;
  const 전안 = 안(전x,전y);
  if (!전안){
    if (안(e.x,e.y)){
      const 문으로 = 문통과 && 전y >= u.y+u.h && e.x > S.문.왼+반*0.5 && e.x < S.문.오-반*0.5;
      if (!문으로){
        // 한 축씩 물러선다 — 판자를 따라 미끄러진다
        if (안(e.x, 전y)){ e.x = 전x; e.vx *= -0.2; }
        if (안(e.x, e.y)){ e.y = 전y; e.vy *= -0.2; }
      }
    }
  } else if (문통과 && e.듦){                                  // 든 양은 안에 머문다
    e.x = Math.max(u.x+반*0.6, Math.min(u.x+u.w-반*0.6, e.x));
    e.y = Math.max(u.y+반*0.6, Math.min(u.y+u.h-반*0.4, e.y));
  }
  e.x = Math.max(반, Math.min(W-반, e.x));
  e.y = Math.max(반, Math.min(H-반, e.y));
}

function 시작(n){
  소리.준비(); 소리.누름(); 소리.배경틀기('배경_목장');
  S.단계 = n;
  const v = 단계값(n);
  판크기();
  S.양들 = [];
  for (let i=0;i<v.양;i++){
    let x, y, 번=0;
    do { x = W*0.16 + Math.random()*W*0.68; y = H*0.46 + Math.random()*H*0.3; 번++; }
    while (번 < 40 && S.양들.some(o => Math.hypot(o.x-x,o.y-y) < 양반*2.6));
    S.양들.push({x, y, vx:0, vy:0, 본다: Math.random()<.5?1:-1, 듦:false, 방황: Math.random()*6.283,
                 동작:'가만', 칸:0, 칸시간:Math.random()*.5, 먹기:0, 쉼:Math.random()*3, 놀람:0, 근처:false,
                 자리:null, 잠까지:0});
  }
  const 개 = S.개;
  개.x = W*0.5; 개.y = H*0.9; 개.vx = 개.vy = 0; 개.본다 = -1; 개.쉼 = 0; 개.짖는중 = 0; 동작(개,'가만');
  S.목표 = null; S.든양 = 0; S.짖음 = 0; S.짖기쿨 = 0;
  S.총시간 = v.시간; S.남은 = v.시간; S.겁 = v.겁;
  document.getElementById('단계').textContent = n + '탄';
  document.getElementById('첫막').classList.add('숨김');
  document.getElementById('끝막').classList.add('숨김');
  document.getElementById('짖기단추').classList.add('보임');
  S.도는중 = true; S.마지막 = performance.now();
  S.틱번호 = (S.틱번호||0) + 1; const 번 = S.틱번호;   // 같은 판이 두 번 돌지 않게
  requestAnimationFrame(t => 돌기(t, 번));
}

// ── 손가락·마우스 ------------------------------------------------
function 자리(e){
  const t = e.touches ? e.touches[0] : e;
  const r = 판.getBoundingClientRect();
